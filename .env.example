# ── Firebase client (public web config) ─────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin SDK (server only — NEVER expose to the client) ─────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Admin allow-list (comma-separated Gmail addresses) ────────────────────
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com

# ── Uploads: Vercel Blob ──────────────────────────────────────────────────
# Firebase Cloud Storage needs the Blaze (paid) plan, so file uploads go
# through Vercel Blob via POST /api/upload instead. The htc-products Blob
# store is connected to the Vercel project with BLOB_READ_WRITE_TOKEN —
# no keys needed here or in the client.

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=+92XXXXXXXXXX
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sentry error monitoring (free tier, optional) ─────────────────────────
# Leave unset to disable monitoring entirely — the app no-ops gracefully.
# Server/edge (instrumentation.ts, API routes): SENTRY_DSN
# Browser (sentry.client.config.ts): NEXT_PUBLIC_SENTRY_DSN (same value)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
